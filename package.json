{
  "name": "almanac-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Panel and card for the almanac Home Assistant integration (DESIGN.md §17)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "npm run clean && rollup --config rollup.config.mjs",
    "watch": "rollup --config rollup.config.mjs --watch",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "test": "node --test \"custom_components/almanac/frontend/test/*.test.ts\"",
    "clean": "rm -rf custom_components/almanac/frontend/dist"
  },
  "dependencies": {
    "lit": "3.3.1"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "16.0.1",
    "@rollup/plugin-terser": "0.4.4",
    "@rollup/plugin-typescript": "12.1.4",
    "@types/node": "26.6.3",
    "rollup": "4.52.4",
    "tslib": "2.8.1",
    "typescript": "5.9.3"
  }
}
